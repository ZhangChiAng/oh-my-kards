[gd_resource type="Resource" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/art/surface_style.gd" id="script"]



[sub_resource type="SystemFont" id="ChineseFont"]
font_names = PackedStringArray("Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans CJK SC", "sans-serif")
font_weight = 600
multichannel_signed_distance_field = true

[sub_resource type="SystemFont" id="NumberFont"]
font_names = PackedStringArray("Consolas", "DejaVu Sans Mono", "monospace")
font_weight = 700
multichannel_signed_distance_field = true

[sub_resource type="StyleBoxFlat" id="OutlinePanel"]
bg_color = Color(0, 0, 0, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 1, 1, 1)
anti_aliasing = true

[resource]
script = ExtResource("script")
font = SubResource("ChineseFont")
number_font = SubResource("NumberFont")
styles = {"well": SubResource("OutlinePanel")}
strokes = {"card_line_width": 0.4, "line_width": 1.0, "antialiased": true, "highlight_inset": 3.0, "board_line_width": 1.0, "board_antialiased": false, "modal_alpha": 0.77, "drag_source_alpha": 0.3, "arrow_tip_gap": 4.0, "arrow_shadow_width": 6.0, "arrow_width": 2.5, "arrow_tip_length": 5.0, "arrow_head_length": 9.0, "arrow_head_half_width": 5.0, "attack_line_width": 2.0, "casualty_line_width": 3.0, "label_outline_width": 2.0}
